rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidBloodType(bt) {
      return bt in ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+'];
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'bloodType', 'neighborhood', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'bloodType', 'neighborhood', 'avatarUrl', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.role in ['donor', 'recipient']
        && isValidBloodType(data.bloodType)
        && data.neighborhood is string && data.neighborhood.size() >= 1 && data.neighborhood.size() <= 64
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScreeningRecord(data, userId) {
      return data.keys().hasAll(['userId', 'bloodType', 'neighborhood', 'availabilityWindow', 'status', 'summary', 'createdAt'])
        && data.keys().hasOnly(['userId', 'bloodType', 'neighborhood', 'availabilityWindow', 'status', 'summary', 'createdAt'])
        && data.userId == userId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && isValidBloodType(data.bloodType)
        && data.neighborhood is string && data.neighborhood.size() >= 1 && data.neighborhood.size() <= 64
        && data.availabilityWindow is string && data.availabilityWindow.size() >= 1 && data.availabilityWindow.size() <= 64
        && data.status in ['eligible', 'temporary_deferral', 'consult_center']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidHealthChatEntry(data, userId) {
      return data.keys().hasAll(['userId', 'role', 'text', 'createdAt'])
        && data.keys().hasOnly(['userId', 'role', 'text', 'createdAt'])
        && data.userId == userId
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.role in ['user', 'assistant']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 4000
        && data.createdAt is timestamp;
    }

    function isValidDonorProfile(data) {
      return data.keys().hasAll(['ownerUid', 'anonymousHandle', 'bloodType', 'lat', 'lng', 'privacyRadiusMeters', 'neighborhood', 'availabilityWindow', 'screeningStatus', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'anonymousHandle', 'bloodType', 'lat', 'lng', 'privacyRadiusMeters', 'neighborhood', 'availabilityWindow', 'screeningStatus', 'createdAt'])
        && data.ownerUid == request.auth.uid
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.anonymousHandle is string && data.anonymousHandle.size() >= 1 && data.anonymousHandle.size() <= 48
        && isValidBloodType(data.bloodType)
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.privacyRadiusMeters is number && data.privacyRadiusMeters >= 400 && data.privacyRadiusMeters <= 5000
        && data.neighborhood is string && data.neighborhood.size() >= 1 && data.neighborhood.size() <= 64
        && data.availabilityWindow is string && data.availabilityWindow.size() >= 1 && data.availabilityWindow.size() <= 64
        && data.screeningStatus in ['verified', 'pending', 'deferred']
        && data.createdAt is timestamp;
    }

    // Connection probe document
    match /test/connection {
      allow get: if isSignedIn();
    }

    // Private user accounts (strictly owner-only, PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'bloodType', 'neighborhood', 'avatarUrl', 'updatedAt']);

      // Private medical screening submissions (append-only)
      match /screenings/{screeningId} {
        allow get: if isValidId(userId) && isValidId(screeningId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(screeningId)
          && isOwner(userId)
          && isValidScreeningRecord(incoming(), userId)
          && incoming().createdAt == request.time;
      }

      // Private AI health chat history (append-only)
      match /healthChats/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(messageId)
          && isOwner(userId)
          && isValidHealthChatEntry(incoming(), userId)
          && incoming().createdAt == request.time;
      }
    }

    // Anonymized public donor directory (no PII)
    match /donors/{donorId} {
      allow get: if isValidId(donorId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.screeningStatus == 'verified';
      allow create: if isValidId(donorId)
        && isSignedIn()
        && isValidDonorProfile(incoming())
        && incoming().createdAt == request.time;
      allow delete: if isValidId(donorId)
        && isSignedIn()
        && existing().ownerUid == request.auth.uid;
    }
  }
}
